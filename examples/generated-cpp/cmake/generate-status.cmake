# Generate acme/status.hpp from the status table.
#
#   cmake -DINPUT=data/status-codes.txt -DOUTPUT=<build>/generated/include/acme/status.hpp -P generate-status.cmake
#
# Each table row "name value description" becomes a documented enumerator of acme::status and a
# case of acme::name.
cmake_minimum_required(VERSION 4.3)

file(STRINGS "${INPUT}" _lines)
set(_enumerators "")
set(_cases "")
foreach(_line IN LISTS _lines)
  if(_line MATCHES "^#" OR _line MATCHES "^[ \t]*$")
    continue()
  endif()
  if(NOT _line MATCHES "^([a-z_]+)[ \t]+([0-9]+)[ \t]+(.+)$")
    message(FATAL_ERROR "${INPUT}: cannot read the row '${_line}'")
  endif()
  string(APPEND _enumerators "    /// ${CMAKE_MATCH_3}\n    ${CMAKE_MATCH_1} = ${CMAKE_MATCH_2},\n")
  string(APPEND _cases "    case status::${CMAKE_MATCH_1}:\n        return \"${CMAKE_MATCH_1}\";\n")
endforeach()

file(WRITE "${OUTPUT}" "// Generated by cmake/generate-status.cmake from data/status-codes.txt; do not edit.
#pragma once

#include <string_view>

namespace acme {

/// The outcome of an acme operation, one enumerator per row of the status table.
enum class status : int {
${_enumerators}};

/// The name of a status code, as written in the status table.
constexpr std::string_view name(status code) noexcept {
    switch (code) {
${_cases}    }
    return \"unknown\";
}

} // namespace acme
")
